# vim: set ft=zsh expandtab:

msec2time() {
    zmodload zsh/datetime
    if (( $# == 0 )); then
        strftime %c
        TZ=GMT strftime %c
    else 
        while (( $# > 0 )); do
            if [[ $1 =~ '([0-9]+)' ]]; then
                local ms=$match[1] s
                (( ${#ms} > 3 )) && s=${ms:0:-3}  # trim 1/1000ths
                strftime "$s => %c" $s
                TZ=GMT strftime "$s => %c" $s
                print
            fi
            shift
        done
    fi
}
