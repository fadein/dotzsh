# vim: set ft=zsh expandtab:

# Split an environment variable on a delimiter (default ':')
# and return the nth item
nth () {
    if (( $# < 2 )); then
		print "Too few arguments to nth: $*"
		print "Usage: nth <position> <list> <delimiter>"
		return 1
	fi
    local IFS=${3-":"}
    print ${${=2}[$1]}
}
