# vim: set ft=zsh expandtab:

undosubdirs() {
    if (( $# == 0 )); then
        setopt local_options no_null_glob
        local dir res
        for dir in *(/); do
			print "Really undo $dir (y/N)?"
			read res
            case $res in
                y*|Y*)
                    command mv -i $dir/* .
                    command rmdir $dir ;;
            esac
		done
	else
		command mv -i $1/* .
		command rmdir $1
	fi
}
